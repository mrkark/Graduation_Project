# Сервер
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Microsoft SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_NAME=BunkaiExplorer
DB_USER=sa
DB_PASSWORD=ChangeMe#12345
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true

# JWT
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Загрузка файлов
UPLOAD_MAX_VIDEO_MB=200
UPLOAD_DIR=../uploads

# Резервные копии
BACKUP_DIR=/tmp/bunkai-explorer-backups

# Seed-пароли (используются server/scripts/generate-seed-sql.js)
SEED_ADMIN_PASSWORD=Admin#12345
SEED_DEMO_PASSWORD=Demo#12345
