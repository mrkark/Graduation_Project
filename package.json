{
  "name": "bunkai-explorer",
  "version": "1.0.0",
  "description": "Bunkai Explorer — Karate Shotokan 3D Dojo with AI Motion Capture",
  "scripts": {
    "network:init": "node scripts/ensure-network-and-ssl.js",
    "prestart": "node scripts/ensure-network-and-ssl.js",
    "start": "node scripts/start-all.js",
    "predev": "node scripts/ensure-network-and-ssl.js",
    "dev": "node scripts/start-all.js",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "predocker:up": "node scripts/ensure-network-and-ssl.js",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "check:ports": "node scripts/check_port_conflicts.js",
    "audit:performance": "node scripts/verify_page_optimization_and_nginx.js",
    "test:functional": "node scripts/functional_role_tests.js"
  },
  "author": "mrkark",
